# 只有在服务商、费用与数据处理方式确认后才开启。
MODEL_ENABLED=0
MODEL_API_KEY=
# 或填写已忽略的密钥文件名：.env.deepseek / .env.qwen
MODEL_CREDENTIAL_FILE=
MODEL_BASE_URL=
MODEL_NAME=
# 确认单次最大费用后填写保守预留金额，单位分；未配置时拒绝调用。
MODEL_CALL_RESERVE_CENTS=0

# 邮箱登录：先核实已有CloudBase环境、登录/注册配置与邮件额度，再显式启用。
# 默认关闭；没有配置时真实接口返回 AUTH_NOT_CONFIGURED，不使用测试验证码。
CLOUDBASE_ENV_ID=
BLOOMATE_EMAIL_ENABLED=0
BLOOMATE_EMAIL_DAILY_LIMIT=100
BLOOMATE_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# 仅本机HTTP验收用 local + 0；线上必须改为 production + 1，使用HTTPS。
BLOOMATE_APP_MODE=local
BLOOMATE_COOKIE_SECURE=0
# 仅受信任的服务端代理使用；不填写到NEXT_PUBLIC变量。
BLOOMATE_PROXY_SHARED_SECRET=

# 对外公开的运营者和联系邮箱；不是密钥。未填写时只能本机验收，生产拒绝业务使用。
BLOOMATE_OPERATOR_NAME=
BLOOMATE_CONTACT_EMAIL=
